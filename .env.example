# MK HomeLab Control Center - environment configuration
# Copy to .env and fill in real values before running `docker compose up -d`.

# --- Core / auth -------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=
SESSION_TTL_HOURS=12

ADMIN_EMAIL=admin@homelab.local
ADMIN_PASSWORD=

# Origin the frontend is served from (used for CORS on the backend).
CORS_ORIGIN=http://localhost:8080
WEB_PORT=8080

# --- Docker integration --------------------------------------------------
DOCKER_ENABLED=true

# --- Prometheus (section 37 - primary metrics source) --------------------
PROMETHEUS_ENABLED=false
PROMETHEUS_URL=http://192.168.1.24:9090

# --- Proxmox VE (M83, 192.168.1.23) --------------------------------------
PROXMOX_ENABLED=false
PROXMOX_URL=https://192.168.1.23:8006
# Format: user@realm!tokenid, e.g. root@pam!homelab-cockpit
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_NODE=m83
# Proxmox's default cert is self-signed; set to false once you install a
# trusted certificate.
PROXMOX_INSECURE_TLS=true

# --- Home Assistant (Raspberry Pi) ---------------------------------------
HOMEASSISTANT_ENABLED=false
HOMEASSISTANT_URL=http://192.168.1.X:8123
HOMEASSISTANT_TOKEN=

# --- TrueNAS Scale (M710q, 192.168.1.22) ----------------------------------
TRUENAS_ENABLED=false
TRUENAS_URL=https://192.168.1.22
TRUENAS_API_KEY=

# --- Uptime Kuma (section 37 - availability data source) -----------------
# Reads Uptime Kuma's built-in Prometheus /metrics endpoint. Generate a key
# under Settings > API Keys, then enable "Show Prometheus Metrics".
UPTIME_KUMA_ENABLED=false
UPTIME_KUMA_URL=http://192.168.1.24:3002
UPTIME_KUMA_API_KEY=

# --- AdGuard Home (DNS stats + protection toggle, section 13) ------------
ADGUARD_ENABLED=false
ADGUARD_URL=http://192.168.1.24:3001
# Leave both blank if AdGuard Home has no login configured.
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# --- Nginx Proxy Manager (proxies + certificate expiry, section 14) ------
NPM_ENABLED=false
NPM_URL=http://192.168.1.24:81
NPM_IDENTITY=
NPM_SECRET=

# --- WireGuard via wg-easy (peers, section 15) ----------------------------
# Only wg-easy's REST API is supported; plain wg-quick has no HTTP API.
WIREGUARD_ENABLED=false
WIREGUARD_URL=http://192.168.1.24:51821
WIREGUARD_PASSWORD=

# --- Frigate (cameras/events/stats, section 17) ---------------------------
FRIGATE_ENABLED=false
FRIGATE_URL=http://192.168.1.24:5000

# --- Zigbee2MQTT (best-effort device count, section 16) -------------------
# Requires Zigbee2MQTT's optional HTTP frontend API; not present on every
# install/version, so this may simply stay unavailable.
ZIGBEE2MQTT_ENABLED=false
ZIGBEE2MQTT_URL=http://192.168.1.24:8080

# --- Docker Hub update checks (section 39) --------------------------------
# Only Docker Hub images are checked; other registries show "undetermined".
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_INTERVAL_MINUTES=60

# --- "Open native UI" links (section 45) - non-secret, safe to expose ----
LINK_PROXMOX_URL=https://192.168.1.23:8006
LINK_TRUENAS_URL=https://192.168.1.22
LINK_GRAFANA_URL=http://192.168.1.24:3000
LINK_ADGUARD_URL=http://192.168.1.24:3001
LINK_NPM_URL=http://192.168.1.24:81
LINK_PORTAINER_URL=http://192.168.1.24:9000
LINK_HOMEASSISTANT_URL=http://192.168.1.X:8123
LINK_FRIGATE_URL=http://192.168.1.24:5000
LINK_UPTIME_KUMA_URL=http://192.168.1.24:3002
